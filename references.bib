issn = {0149-5992},
journal = {Diabetes care},
keywords = {Complications ;  Data processing ;  Diabetes ;  Glucose ;  Hemoglobin ;  Human beings ;  Hyperglycemia ;  Hypoglycemia ;  International agencies ;  Life sciences ;  Medical personnel ;  Microvessels ;  Monitoring ;  Physicians ;  Standardization},
language = {eng},
