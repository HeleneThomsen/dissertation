	url = {http://ovidsp.ovid.com/ovidweb.cgi?T=JS&PAGE=reference&D=medl&NEWS=N&AN=37806236},
	doi = {10.1016/j.jdiacomp.2023.108519},
	abstract = {AIM: To investigate the relationship between glycemic variability (GV) and diastolic dysfunction in patients with type 2 diabetes mellitus (DM) without coronary artery disease., METHODS: Seventy-eight patients with type 2 DM without coronary artery disease were enrolled into the study. Diastolic function was assessed by echocardiography (Philips IE33); GV was evaluated by continuous monitoring of glucose (CGM, Guardian TM Connect System, Medtronic). According to the GV all studied patients were divided into two groups: group I - standard deviation (SD) {\textgreater} 2 (high GV), n = 40; group II - SD {\textless}= 1.9 (normal GV), n = 38., RESULTS: Group I were older (49+/-9 vs 46+/-5; p{\textless}0.05), with a longer duration of DM (10+/-9.5 vs 6+/-5.5; p{\textless}0.01). Patients in group I had more severe diastolic dysfunction which was characterized by an increased values of myocardial stiffness index (E/e' ratio), speed of early transmitral flow (E, sm/sec) and peak rate of tricuspid regurgitation (V max TR, m/sec). Multivariate regression analysis revealed that high GV and older age of patients were the only significant independent predictors for diastolic dysfunction., CONCLUSIONS: Increased GV is associated with diastolic dysfunction and could predispose to development and progression of heart failure in patients with type 2 DM without coronary arteries disease. Copyright © 2023. Published by Elsevier Inc.},
	number = {11},
	journal = {Journal of diabetes and its complications},
	author = {{Dzhun Yana} and {Mankovsky Georgy} and {Rudenko Nadiya} and {Marushko Yevgen} and {Saienko Yanina} and {Mankovsky Borys}},
	year = {2023},
	keywords = {Diabetes Mellitus, Humans, *Diabetes Mellitus, Type 2, Regression Analysis, eppi-reviewer, Type 2/co [Complications], *Coronary Artery Disease, *Heart Failure, Coronary Artery Disease/co [Complications], Coronary Artery Disease/ep [Epidemiology], Diastole, Heart Failure/co [Complications]},
	pages = {108519},
	file = {Dzhun et al. - 2023 - Glycemic variability is associated with diastolic .pdf:/Users/au605715/Zotero/storage/VGGI9HUR/Dzhun et al. - 2023 - Glycemic variability is associated with diastolic .pdf:application/pdf},
}


