@article{Gimenez2011,
	title = {Preclinical arterial disease in patients with type 1 diabetes without other major cardiovascular risk factors or micro-/ macrovascular disease.},
	volume = {8},
	issn = {1479-1641},
	shorttitle = {Gimenez (2011)},
	url = {http://ovidsp.ovid.com/ovidweb.cgi?T=JS&PAGE=reference&D=med8&NEWS=N&AN=21109602},
	doi = {10.1177/1479164110388674},
	abstract = {We aimed to investigate preclinical atherosclerosis in T1D and its relationship with glucose profile and endothelial/ inflammatory markers. Thirty-eight T1D patients without additional cardiovascular risk factors or micro-/macrovascular complications and 22 healthy matched subjects were included. FMD and cIMT/fIMT were performed in addition to 72-h continuous glucose monitoring and the measurement of endothelial/inflammatory markers. Lower FMD percentages and greater cIMT/fIMT were observed in patients with T1D in comparison with controls (FMD 7.0 +/- 3.1\% vs. 9.6 +/- 2.2\%; p{\textless}0.005; cIMT 0.523 +/- 0.091 mm vs. 0.471 +/- 0.061 mm; p{\textless}0.05 and fIMT 0.512 +/- 0.172 mm vs. 0.394 +/- 0.061 mm; p{\textless}0.01, for patients and controls, respectively). T1D subjects in the highest tertile of cIMT were older than those in the lowest group (39.9 +/- 9.5 vs. 29.6 +/- 4.7 years; p{\textless}0.005) and had a longer duration of the disease (18.7 +/- 5.4 years vs. 11.8 +/- 6.4 years). The higher the cIMT tertile, the greater the fIMT (0.397 +/- 0.114 mm vs. 0.431 +/- 0.082 mm vs. 0.583 +/- 0.197 mm; p{\textless}0.05). MAGE was negatively correlated to FMD (r=-0.328; p{\textless}0.05) and positively to cIMT (r=0.322; p{\textless}0.05). There were no differences between cIMT tertiles in terms of metabolic parameters or endothelial and inflammatory markers. Signals of preclinical atherosclerosis in T1D even in the absence of cardiovascular risk factors and micro- / macrovascular disease are reported. Our findings suggest that daily glucose instability could negatively impact vascular function and structure.},
	number = {1},
	journal = {Diabetes \& vascular disease research},
	author = {{Gimenez Marga} and {Gilabert Rosa} and {Lara Merce} and {Conget Ignacio}},
	year = {2011},
	keywords = {Diabetes Mellitus, Humans, *Diabetes Mellitus, Adult, Female, Male, Middle Aged, Cross-Sectional Studies, eppi-reviewer, Risk Factors, Type 1/bl [Blood], Endothelium, Vascular/pp [Physiopathology], Atherosclerosis/bl [Blood], Blood Glucose/me [Metabolism], Type 1/dg [Diagnostic Imaging], Atherosclerosis/dg [Diagnostic Imaging], Tunica Intima/dg [Diagnostic Imaging], Ultrasonography, Type 1/co [Complications], Vasodilation, *Atherosclerosis/et [Etiology], Biomarkers/bl [Blood], Type 1/pp [Physiopathology]},
	pages = {5--11},
	file = {Giménez et al. - 2011 - Preclinical arterial disease in patients with type.pdf:/Users/au605715/Zotero/storage/JZCNLSJQ/Giménez et al. - 2011 - Preclinical arterial disease in patients with type.pdf:application/pdf},
}

@article{Gordin2008,
	title = {Glucose variability, blood pressure and arterial stiffness in type 1 diabetes.},
	volume = {80},
	issn = {0168-8227},
	shorttitle = {Gordin (2008)},
	url = {http://ovidsp.ovid.com/ovidweb.cgi?T=JS&PAGE=reference&D=med7&NEWS=N&AN=18325620},
	doi = {10.1016/j.diabres.2008.01.010},
	abstract = {AIMS: Evidence suggests that chronic hyperglycaemia predicts not only microvascular disease but also macrovascular disease, however it is not known whether it is the glucose variability per se or the total glucose exposure that confers risk. The objective of this study was to investigate whether daily glucose variability influence blood pressure and arterial stiffness, an early sign of macrovascular disease, at baseline and during a hyperglycaemic clamp in patients with type 1 diabetes., METHODS: Twenty-two non-smoking male patients with type 1 diabetes without any diabetic complications, participated in the study. The patients were monitored for 72-h using a continuous glucose monitoring system. Before and during a 2-h hyperglycaemic clamp, blood pressure as well as pulse wave analysis and pulse wave velocity (PWV) were performed to assess arterial stiffness., RESULTS: No correlation was observed between mean amplitude of glycaemic excursions (MAGE) and arterial stiffness at baseline. There was a correlation between mean daily glucose and aortic PWV even after adjusting for BMI, HbA(1c), and duration of diabetes in a multiple regression analysis (r=0.48; P{\textless}0.01). MAGE (r=0.52; P{\textless}0.01) correlated independently with the change in aortic DBP during the clamp., CONCLUSIONS: This study suggests that high mean daily blood glucose but not glucose variability per se is associated with arterial stiffness in patients with T1D. Daily glucose variability is positively associated with the change in central blood pressure during a hyperglycaemic clamp.},
	number = {3},
	journal = {Diabetes research and clinical practice},
