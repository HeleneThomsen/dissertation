	keywords = {Biobank, Clinical cohort study},
	pages = {1187--1194},
	file = {Full Text PDF:/Users/au605715/Zotero/storage/JBTF2RZQ/Shilo et al. - 2021 - 10 K a large‐scale prospective longitudinal study in Israel.pdf:application/pdf},
