	doi = {10.1016/j.cca.2017.06.014},
	abstract = {BACKGROUND: We explored the impact of glycemic variability on the occurrence of periprocedural myocardial infarction and major adverse cardiovascular events (MACE) after coronary intervention in patients with stable angina pectoris (SAP) at 6months follow-up., METHODS: From May 2015 to April 2016, a total of 746 patients with SAP were divided to high glycemic variability group (H group) (n=261) and low glycemic variability group (L group) (n=485). The primary end point was incidence of periprocedural myocardial infarction and MACE at 6months follow-up., RESULTS: The occurrence of periprocedural myocardial infarction occurred in 18.8\% of patients in H group and in 12.4\% in L group (P=0.03). The incidence of MACE at 6months follow-up was 9.6\% in H group and 4.5\% in L group (P=0.01). Multivariable analysis suggested that high glycemic variability conferred a 53\% risk increment of 6months follow-up MACE (odds ratio 2.13, 95\% confidence interval 1.85-5.38; P=0.01)., CONCLUSIONS: The trial shows that higher blood glucose variability was correlated with higher incidence of periprocedural myocardial infarction and MACE at 6months follow-up. Copyright © 2017. Published by Elsevier B.V.},
	journal = {Clinica chimica acta; international journal of clinical chemistry},
