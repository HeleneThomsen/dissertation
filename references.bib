@article{Yokota2019,
	title = {Association of glycemic variability with left ventricular diastolic function in type 2 diabetes mellitus.},
	volume = {18},
	issn = {1475-2840},
	shorttitle = {Yokota (2019)},
	url = {http://ovidsp.ovid.com/ovidweb.cgi?T=JS&PAGE=reference&D=med16&NEWS=N&AN=31805945},
	doi = {10.1186/s12933-019-0971-5},
	abstract = {BACKGROUND: Type 2 diabetes mellitus (T2DM) is a major cause of heart failure (HF) with preserved ejection fraction (HFpEF), usually presenting as left ventricular (LV) diastolic dysfunction. Thus, LV diastolic function should be considered a crucial marker of a preclinical form of DM-related cardiac dysfunction. However, the impact of glycemic variability (GV) on LV diastolic function in such patients remains unclear., METHODS: We studied 100 asymptomatic T2DM patients with preserved LV ejection fraction (LVEF) without coronary artery disease (age: 60 +/- 14 years, female: 45\%). GV was evaluated as standard deviation of blood glucose level using continuous glucose monitoring system for at least 72 consecutive hours. LV diastolic function was defined as mitral inflow E and mitral e' annular velocities (E/e'), and {\textgreater} 14 was determined as abnormal., RESULTS: E/e' in patients with high GV ({\textgreater}= 35.9 mg/dL) was significantly higher than that in patients with low GV (11.3 +/- 3.9 vs. 9.8 +/- 2.8, p = 0.03) despite similar age, gender-distribution, and hemoglobin A1c (HbA1c). Multivariate logistic regression analysis showed that GV {\textgreater}= 35.9 mg/dL (odds ratio: 3.67; 95\% confidence interval: 1.02-13.22; p {\textless} 0.05) was an independently associated factor, as was age, of E/e' {\textgreater} 14. In sequential logistic models for the associations of LV diastolic dysfunction, one model based on clinical variables including age, gender and hypertension was not improved by addition of HbA1c (p = 0.67) but was improved by addition of high GV (p = 0.04)., CONCLUSION: Since HFpEF is a syndrome caused by diverse agents, reducing GV may represent a potential new therapeutic strategy for the prevention of the development of HFpEF in T2DM patients.},
	number = {1},
	journal = {Cardiovascular diabetology},
	author = {{Yokota Shun} and {Tanaka Hidekazu} and {Mochizuki Yasuhide} and {Soga Fumitaka} and {Yamashita Kentaro} and {Tanaka Yusuke} and {Shono Ayu} and {Suzuki Makiko} and {Sumimoto Keiko} and {Mukai Jun} and {Suto Makiko} and {Takada Hiroki} and {Matsumoto Kensuke} and {Hirota Yushi} and {Ogawa Wataru} and {Hirata Ken-Ichi}},
	year = {2019},
	keywords = {Diabetes Mellitus, Humans, *Diabetes Mellitus, Female, Male, Middle Aged, Retrospective Studies, Aged, Time Factors, Prognosis, eppi-reviewer, *Blood Glucose/me [Metabolism], Risk Factors, Type 2/bl [Blood], Type 2/co [Complications], Diastole, Risk Assessment, Biomarkers/bl [Blood], Type 2/di [Diagnosis], *Diabetic Cardiomyopathies/et [Etiology], *Heart Failure/et [Etiology], *Ventricular Dysfunction, *Ventricular Function, Diabetic Cardiomyopathies/dg [Diagnostic Imaging], Diabetic Cardiomyopathies/pp [Physiopathology], Heart Failure/dg [Diagnostic Imaging], Heart Failure/pp [Physiopathology], Left, Left/dg [Diagnostic Imaging], Left/et [Etiology], Left/pp [Physiopathology], Stroke Volume, Ventricular Dysfunction},
	pages = {166},
	file = {Yokota et al. - 2019 - Association of glycemic variability with left vent.pdf:/Users/au605715/Zotero/storage/J9L86LC9/Yokota et al. - 2019 - Association of glycemic variability with left vent.pdf:application/pdf},
}

@article{YurunLu2025,
year = {2025},
abstract = {Continuous glucose monitoring (CGM) technology has grown rapidly to track real-time blood glucose levels and trends with improved sensor accuracy. The ease of use and wide availability of CGM will facilitate safe and effective decision making for diabetes management. Here, we developed an attention-based deep learning model, CGMformer, pretrained on a well-controlled and diverse corpus of CGM data to represent individual's intrinsic metabolic state and enable clinical applications. During pretraining, CGMformer encodes glucose dynamics including glucose level, fluctuation, hyperglycemia, and hypoglycemia into latent space with self-supervised learning. It shows generalizability in imputing glucose value across five external datasets with different populations and metabolic states (MAE = 3.7 mg/dL). We then fine-tuned CGMformer towards a diverse panel of downstream tasks in the screening of diabetes and its complications using task-specific data, which demonstrated a consistently boosted predictive accuracy over direct fine-tuning on a single task (AUROC = 0.914 for type 2 diabetes (T2D) screening and 0.741 for complication screening). By learning an intrinsic representation of an individual's glucose dynamics, CGMformer classifies non-diabetic individuals into six clusters with elevated T2D risks, and identifies a specific cluster with lean body-shape but high risk of glucose metabolism disorders, which is overlooked by traditional glucose measurements. Furthermore, CGMformer achieves high accuracy in predicting an individual's postprandial glucose response with dietary modelling (Pearson correlation coefficient = 0.763) and helps personalized dietary recommendations. Overall, CGMformer pretrains a transformer neural network architecture to learn an intrinsic representation by borrowing information from a large amount of daily glucose profiles, and demonstrates predictive capabilities fine-tuned towards a broad range of downstream applications, holding promise for the early warning of T2D and recommendations for lifestyle modification in diabetes management.},
author = {Lu, Yurun and Liu, Dan and Liang, Zhongming and Liu, Rui and Chen, Pei and Liu, Yitong and Li, Jiachen and Feng, Zhanying and Li, Lei M and Sheng, Bin and Jia, Weiping and Chen, Luonan and Li, Huating and Wang, Yong},
address = {China},
copyright = {The Author(s) 2025. Published by Oxford University Press on behalf of China Science Publishing & Media Ltd.},
issn = {2095-5138},
journal = {National science review},
language = {eng},
number = {5},
pages = {nwaf039-},
publisher = {Oxford University Press},
title = {A pretrained transformer model for decoding individual glucose dynamics from continuous glucose monitoring data},
volume = {12},
}

