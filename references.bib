journal = {Clinical Research in Cardiology},
keywords = {Age factors ;  Biochemical markers ;  Body mass index ;  Body size ;  Cardiology ;  Chronic diseases ;  Comorbidity ;  Congestive heart failure ;  Data Analysis ;  Diseases ;  Fat ;  Heart failure ;  Human beings ;  Impact ;  Medicine ;  Mortality ;  Natriuretic Peptide Brain ;  Obesity ;  Patient Acuity ;  Peptide Fragments ;  Prognosis ;  Risk ;  Stroke Volume ;  Troponin},
language = {eng},
