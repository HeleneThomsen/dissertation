keywords = {Data Collection ;  Female ;  Hawaii ;  Health Status ;  Health Status Disparities ;  Human beings ;  Male ;  Public health},
language = {eng},
number = {8},
pages = {168-171},
publisher = {University Clinical, Education & Research Associate (UCERA)},
title = {The challenges of collecting data on race and ethnicity in a diverse, multiethnic state},
volume = {70},
year = {2011},
}



