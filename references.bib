@article{Kakuta2017,
	title = {Impact of renal function on the underlying pathophysiology of coronary plaque composition in patients with type 2 diabetes mellitus.},
	volume = {16},
	issn = {1475-2840},
	shorttitle = {Kakuta (2017)},
	url = {http://ovidsp.ovid.com/ovidweb.cgi?T=JS&PAGE=reference&D=med14&NEWS=N&AN=29025416},
	doi = {10.1186/s12933-017-0618-3},
	abstract = {BACKGROUND: Both the progression of diabetic kidney disease and increased glycemic variability play important roles in the pathogenesis of coronary plaque formation via inflammatory pathways in patients with type 2 diabetes mellitus (T2DM). Therefore we evaluated the role of renal function in the contributory effects of blood glucose fluctuations and blood levels of inflammatory cytokine concentrations on the tissue characteristics of coronary plaques in patients with T2DM., METHODS: We prospectively enrolled 71 T2DM patients (mean age: 68 +/- 9, male 79\%) with 153 coronary artery lesions. Patients were divided into 2 groups according to their estimated glomerular filtration rate (eGFR) levels: Group 1 ({\textgreater}= 60 mL/min/1.73 m2, n = 40) and Group 2 ({\textless} 60 mL/min/1.73 m2, n = 31). All patients underwent continuous glucose monitoring (CGM) for 120 h and the mean amplitude of glycemic excursions (MAGE) was calculated. Serum tumor necrosis factor (TNF)-alpha was also measured. In addition, gray-scale coronary intravascular ultrasound (IVUS) and iMap-IVUS were performed in the coronary lesions with {\textless} 50\% luminal reduction., RESULTS: In Group 1, MAGE correlated with percent lipidic volume (\%LV) (r = 0.477, p = 0.002). In this group, stepwise multivariate linear regression analyses showed that only MAGE was independently associated with \%LV (beta = 0.477, p = 0.002). In contrast, in Group 2, only serum TNF-alpha correlated with percent fibrotic volume (\%FV) (r = - 0.471, p = 0.007), \%LV (r = 0.496, p = 0.005) and percent necrotic volume (\%NV) (r = 0.426, p = 0.017). In this group, stepwise multivariate linear regression analyses showed that only serum TNF-alpha was independently associated with each tissue characteristic (\%FV beta = - 0.471 and p = 0.007, \%LV beta = 0.496 and p = 0.005, \%NV: beta = 0.426 and p = 0.017)., CONCLUSIONS: In T2DM patients, the tissue characteristics of coronary plaques were associated with MAGE in patients with eGFR {\textgreater}= 60 mL/min/1.73 m2 and with serum TNF-alpha in those with eGFR {\textless} 60 mL/min/1.73 m2.},
	number = {1},
	journal = {Cardiovascular diabetology},
	author = {{Kakuta Kentaro} and {Dohi Kaoru} and {Miyoshi Miho} and {Yamanaka Takashi} and {Kawamura Masaki} and {Masuda Jun} and {Kurita Tairo} and {Ogura Toru} and {Yamada Norikazu} and {Sumida Yasuhiro} and {Ito Masaaki}},
	year = {2017},
	keywords = {Diabetes Mellitus, Humans, *Diabetes Mellitus, Female, Male, Middle Aged, Aged, Prospective Studies, eppi-reviewer, Type 2/pp [Physiopathology], 80 and over, Type 2/di [Diagnosis], *Coronary Artery Disease/pp [Physiopathology], *Glomerular Filtration Rate/ph [Physiology], *Kidney/ph [Physiology], Atherosclerotic, Coronary Artery Disease/di [Diagnosis], Plaque},
	pages = {131},
	file = {Kakuta et al. - 2017 - Impact of renal function on the underlying pathoph.pdf:/Users/au605715/Zotero/storage/NQKXX26W/Kakuta et al. - 2017 - Impact of renal function on the underlying pathoph.pdf:application/pdf},
}


@article{Kaneshiro2011,
abstract = {Race and ethnicity are commonly used predictor variables in medical and public health research. Including these variables has helped researchers to describe the etiology of certain disease states. Including race and ethnicity in research has been hypothesis generating in terms of the relationship between genetic and environmental factors in the development of disease. Eliminating health disparities among different racial and ethnic groups has become a national priority. However, incorporating race and ethnicity into health research is complex because these variables are difficult to define and individuals often identify with more than one race or ethnicity. As a "minority-majority", multiethnic, multiracial state, Hawai'i faces unique challenges in incorporating race and ethnicity into research. As the demographics of the United States continue to evolve, many of the challenges faced in Hawai'i will apply to the United States as a whole.},
