}

@article{Chen2010,
	title = {Correlation between glucose fluctuations and carotid intima-media thickness in type 2 diabetes.},
	volume = {90},
	issn = {0168-8227},
	shorttitle = {Chen (2010)},
	url = {http://ovidsp.ovid.com/ovidweb.cgi?T=JS&PAGE=reference&D=med8&NEWS=N&AN=20605247},
	doi = {10.1016/j.diabres.2010.05.004},
	abstract = {AIMS: To evaluate the relationship between blood glucose fluctuations and carotid atherosclerosis (AS) in type 2 diabetic patients., METHODS: A case-control study included 36 patients with type 2 diabetes and 10 controls. According to the levels of carotid intima-media thickness (CIMT), 36 diabetic patients were classified into two groups, the diabetes mellitus without atherosclerosis (DM-AS, n=20) and diabetes mellitus with atherosclerosis (DM+AS, n=16). The glucose excursions were assessed by the following parameters obtained from continuous glucose monitoring system for 72h: the mean blood glucose (MBG) and its standard deviation (SD), the area under the ROC curve when the blood glucose was higher than 7.8mmol/L (AUC7.8), the mean amplitude of glycemic excursion (MAGE), the mean of daily differences (MODD), and the largest amplitude of glycemic excursion (LAGE)., RESULTS: The levels of MBG, SD, MAGE, LAGE, and AUC7.8 were gradually increased with the progression of atherosclerosis (P{\textless}0.05). The Spearman's correlation analysis showed that the CIMT was correlated to the age (R=0.58, P{\textless}0.001), the duration (R=0.50, P{\textless}0.001), the MAGE (R=0.34, P=0.021), and the LAGE (R=0.31, P=0.035)., CONCLUSION: These results suggest that glucose fluctuations may accelerate atherogenesis in older type 2 diabetic patients who had a longer duration.},
	number = {1},
	journal = {Diabetes research and clinical practice},
	author = {{Chen Xiao-min} and {Zhang Yan} and {Shen Xing-ping} and {Huang Qun} and {Ma Hong} and {Huang Yang-Ling} and {Zhang Wen-Qiang} and {Wu Hao-Jie}},
	year = {2010},
	keywords = {Diabetes Mellitus, Humans, *Diabetes Mellitus, Adult, Female, Male, Middle Aged, Monitoring, Aged, Case-Control Studies, Ambulatory, eppi-reviewer, Risk Factors, Type 2/bl [Blood], Type 2/co [Complications], *Carotid Arteries/pa [Pathology], Carotid Arteries/dg [Diagnostic Imaging], *Blood Glucose/an [Analysis], *Diabetic Angiopathies/ep [Epidemiology], *Tunica Intima/pa [Pathology], *Tunica Media/pa [Pathology], 80 and over, Aging, Atherosclerosis/dg [Diagnostic Imaging], Atherosclerosis/ep [Epidemiology], Atherosclerosis/pa [Pathology], Diabetic Angiopathies/bl [Blood], Diabetic Angiopathies/dg [Diagnostic Imaging], Diabetic Angiopathies/pa [Pathology], Disease Progression, Severity of Illness Index, Statistics as Topic, Tunica Intima/dg [Diagnostic Imaging], Tunica Media/dg [Diagnostic Imaging], Type 2/pa [Pathology], Ultrasonography},
	pages = {95--9},
