@article{Zhang2013,
	title = {The effects of glucose fluctuation on the severity of coronary artery disease in type 2 diabetes mellitus.},
	volume = {2013},
	issn = {2314-6745},
	shorttitle = {Zhang (2013)},
	url = {http://ovidsp.ovid.com/ovidweb.cgi?T=JS&PAGE=reference&D=med10&NEWS=N&AN=23936867},
	doi = {10.1155/2013/576916},
	abstract = {OBJECTIVES: To explore the difference of glucose fluctuations between the normal subjects and diabetes mellitus (DM) patients and explore their impact on the development of CAD in type 2 DM patients., METHODS: The subjects were divided into 3 groups: normal control (group A, n = 40), type 2 DM patients without cardiovascular complications (group B, n = 56), and type 2 DM patients with cardiovascular complications (group C, n = 92). The SYNTAX scores were collected in group C. CGMS for 72 h was applied on all the subjects. The indexes such as MBG and the LAGE were calculated. Glycemic excursions were compared between groups A, B, and C, respectively., RESULTS: The tested indexes had significant differences among the three groups. SYNTAX scores are related to systolic blood pressure, CRP, MAGE, and HbA1c and are significantly correlated at 6:00-8:00 and 11:00-13:00 time points in group C., CONCLUSIONS: Compared with normal subjects, T2DM patients have greater blood glucose fluctuations; T2DM patients with CAD have larger glucose fluctuations than T2DM patients without CAD. Blood glucose fluctuations are positively correlated with carotid artery intima-media thickness in T2DM patients and have a significant influence on the development of coronary artery.},
	journal = {Journal of diabetes research},
	author = {{Zhang Xingguang} and {Xu Xiuping} and {Jiao Xiumin} and {Wu Jinxiao} and {Zhou Shujing} and {Lv Xiaofeng}},
	year = {2013},
	keywords = {Diabetes Mellitus, Humans, *Diabetes Mellitus, Female, Male, Middle Aged, Aged, eppi-reviewer, *Blood Glucose/me [Metabolism], Type 2/bl [Blood], Type 2/co [Complications], Severity of Illness Index, Coronary Artery Disease/co [Complications], *Coronary Artery Disease/bl [Blood]},
	pages = {576916},
	file = {Zhang et al. - 2013 - The Effects of Glucose Fluctuation on the Severity.pdf:/Users/au605715/Zotero/storage/I6NQNDVM/Zhang et al. - 2013 - The Effects of Glucose Fluctuation on the Severity.pdf:application/pdf;Zhang et al. - 2013 - The Effects of Glucose Fluctuation on the Severity.pdf:/Users/au605715/Zotero/storage/BHXA8JSJ/Zhang et al. - 2013 - The Effects of Glucose Fluctuation on the Severity.pdf:application/pdf},
}


@article{Zhang2020,
	title = {Relationship of ankle-brachial index, vibration perception threshold, and current perception threshold to glycemic variability in type 2 diabetes.},
	volume = {99},
	issn = {0025-7974},
	shorttitle = {Zhang (2020)},
	url = {http://ovidsp.ovid.com/ovidweb.cgi?T=JS&PAGE=reference&D=med18&NEWS=N&AN=32195933},
	doi = {10.1097/MD.0000000000019374},
	abstract = {To explore the relationship of glycemic variability with lower extremity arterial disease (LEAD) and diabetic peripheral neuropathy (DPN). Seventy-eight patients with type 2 diabetes were enrolled. All patients underwent 72-hour dynamic blood glucose monitoring and obtained mean amplitude of glycemic excursions (MAGE), mean of daily differences (MODD), standard deviation of blood glucose (SD), largest amplitude of glycemic excursion (LAGE), mean blood glucose (MBG), T{\textgreater}=10.0 (percentage of time for blood glucose levels {\textgreater}=10.0 mmol/L), T{\textless}=3.9 (percentage of time for blood glucose levels {\textless}=3.9 mmol/L), and other glycemic variability parameters. In the meanwhile, in order to explore the correlation of glycemic variability parameters with ankle-brachial index (ABI), vibration perception threshold (VPT), and current perception threshold (CPT), all patients underwent quantitative diabetic foot screening, including ABI for quantitative assessment of lower extremity arterial lesions and VPT and CPT for quantitative assessment of peripheral neuropathy.Patients were divided into abnormal CPT group (n = 21) and normal CPT group (n = 57) according to the CPT values. Compared with the normal CPT group, abnormal CPT group showed significantly higher levels of HbA1c, longer duration of diabetes, and higher levels of T{\textless}=3.9 (P {\textless} .05). However, there was no significant difference of MAGE, SD, LAGE, MODD, and other glycemic variability parameters between abnormal CPT group and normal CPT group (P {\textgreater} .05). Pearson correlation analysis or Spearman correlation analysis showed that ABI negatively correlated with MBG, T{\textgreater}=10.0, SD, LAGE, and MAGE (P {\textless} .05), but no correlation of ABI with T{\textless}=3.9 and MODD (P {\textgreater} .05) was shown. VPT showed a positive correlation with T{\textgreater}=10.0 (P {\textless} .05), but no correlation with other glycemic variability parameters (P {\textgreater} .05). There was no correlation between the other CPT values and the glycemic variability parameters (P {\textgreater} .05), except that the left and right 250 Hz CPT values were positively correlated with T{\textless}=3.9 (P {\textgreater} .05). The higher the blood glucose levels, the severer the degree of LEAD and DPN lesions; the higher the incidence of hypoglycemia, the severer the degree of DPN lesions; the greater the fluctuation of blood glucose, the severer the degree of LEAD lesions. However, the glycemic variability was not significantly correlated with DPN.},
	number = {12},
	journal = {Medicine},
	author = {{Zhang Chuangbiao} and {Tang Meili} and {Lu Xiaohua} and {Zhou Yan} and {Zhao Wane} and {Liu Yu} and {Liu Yan} and {Guo Xiujie}},
	year = {2020},
	keywords = {Humans, *Diabetes Mellitus, Adult, Female, Male, Middle Aged, Aged, Cross-Sectional Studies, eppi-reviewer, *Blood Glucose/an [Analysis], Severity of Illness Index, Type 2/ep [Epidemiology], *Ankle Brachial Index, *Diabetic Neuropathies/ep [Epidemiology], *Peripheral Arterial Disease/ep [Epidemiology], *Vibration, Diabetic Foot/ep [Epidemiology], Lower Extremity/pp [Physiopathology]},
	pages = {e19374},
	file = {Zhang et al. - 2020 - Relationship of ankle-brachial index, vibration pe.pdf:/Users/au605715/Zotero/storage/QDVKBVFD/Zhang et al. - 2020 - Relationship of ankle-brachial index, vibration pe.pdf:application/pdf},
}




@article{Zhang_2024_review,
	title = {Research progress on the association between glycemic variability index derived from {CGM} and cardiovascular disease complications},
	volume = {61},
	issn = {1432-5233},
	url = {https://link.springer.com/10.1007/s00592-024-02241-0},
	doi = {10.1007/s00592-024-02241-0},
	abstract = {Currently, glycated hemoglobin A1c (HbA1c) has been widely used to assess the glycemic control of patients with diabetes. However, HbA1c has certain limitations in describing both short-term and long-term glycemic control. To more accurately evaluate the glycemic control of diabetes patients, the continuous glucose monitoring (CGM) technology has emerged. CGM technology can provide robust data on short-term glycemic control and introduce new monitoring parameters such as time in range, time above range, and time below range as indicators of glycemic fluctuation. These indicators are used to describe the changes in glycemic control after interventions in clinical research or treatment modifications in diabetes patient care. Recent studies both domestically and internationally have shown that these indicators are not only associated with microvascular complications of diabetes mellitus but also closely related to cardiovascular disease complications and prognosis. Therefore, this article aims to comprehensively review the association between CGM-based glycemic parameters and cardiovascular disease complications by analyzing a large number of domestic and international literature. The purpose is to provide scientific evidence and guidance for the standardized application of these indicators in clinical practice, in order to better evaluate the glycemic control of diabetes patients and prevent the occurrence of cardiovascular disease complications. This research will contribute to improving the quality of life for diabetes patients and provide important references for clinical decision-making.},
	language = {en},
	number = {6},
	urldate = {2025-11-24},
	journal = {Acta Diabetologica},
	author = {Zhang, Lei and Sun, Xiao-Xuan and Tian, Qing-shan},
	month = mar,
	year = {2024},
	pages = {679--692},
	file = {PDF:/Users/au605715/Zotero/storage/L9VWFVMM/Zhang et al. - 2024 - Research progress on the association between glycemic variability index derived from CGM and cardiov.pdf:application/pdf},
}

