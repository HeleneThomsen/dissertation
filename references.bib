language = {eng},
number = {10},
organization = {Faculty of Medicine},
pages = {e151-e199},
publisher = {Amer Diabetes Assoc},
title = {Guidelines and Recommendations for Laboratory Analysis in the Diagnosis and Management of Diabetes Mellitus},
