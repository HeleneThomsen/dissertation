issn = {0149-5992},
journal = {Diabetes care},
keywords = {American Heart Association ;  Cardiology ;  Complications ;  Congestive heart failure ;  Coronary Artery Disease ;  Diabetes ;  Heart failure ;  Human beings ;  Hypertension},
language = {eng},
number = {7},
pages = {1670-1690},
publisher = {Amer Diabetes Assoc},
title = {Heart Failure: An Underappreciated Complication of Diabetes. A Consensus Report of the American Diabetes Association},
volume = {45},
}



@article{Battelino2019,
year = {2019},
abstract = {Improvements in sensor accuracy, greater convenience and ease of use, and expanding reimbursement have led to growing adoption of continuous glucose monitoring (CGM). However, successful utilization of CGM technology in routine clinical practice remains relatively low. This may be due in part to the lack of clear and agreed-upon glycemic targets that both diabetes teams and people with diabetes can work toward. Although unified recommendations for use of key CGM metrics have been established in three separate peer-reviewed articles, formal adoption by diabetes professional organizations and guidance in the practical application of these metrics in clinical practice have been lacking. In February 2019, the Advanced Technologies & Treatments for Diabetes (ATTD) Congress convened an international panel of physicians, researchers, and individuals with diabetes who are expert in CGM technologies to address this issue. This article summarizes the ATTD consensus recommendations for relevant aspects of CGM data utilization and reporting among the various diabetes populations.},
author = {Battelino, T and Danne, T and Bergenstal, R.M and Amiel, S.A and Beck, R and Biester, T and Bosi, E and Buckingham, B.A and
          Cefalu, W.T and Close, K.L and Cobelli, C and Dassau, E and DeVries, J.H and Donaghue, K.C and Dovc, K and Doyle, F.J and Garg, S and Grunberger,
          G and Heller, S and Heinemann, L and Hirsch, I.B and Hovorka, R and Jia, W and Kordonouri, O and Kovatchev, B and Kowalski, A and Laffel, L and Levine,
          B and Mayorov, A and Mathieu, C and Murphy, H.R and Nimri, R and Nørgaard, K and Parkin, C.G and Renard, E and Rodbard, D and Saboo, B and Schatz, D and Stoner,
          K and Urakami, T and Weinzimer, S.A and Phillip, M},
language = {eng},
publisher = {American Diabetes Association},
title = {Clinical targets for continuous glucose monitoring data interpretation : recommendations from the international consensus on time in range},
}

